{
    "variable":  [
                     {
                         "key":  "base_url",
                         "value":  "http://127.0.0.1:8000"
                     },
                     {
                         "key":  "email",
                         "value":  ""
                     },
                     {
                         "key":  "otp_code",
                         "value":  ""
                     },
                     {
                         "key":  "new_password",
                         "value":  ""
                     },
                     {
                         "key":  "attempt_id",
                         "value":  ""
                     },
                     {
                         "key":  "attempt_token",
                         "value":  ""
                     },
                     {
                         "key":  "reset_proof",
                         "value":  ""
                     }
                 ],
    "info":  {
                 "name":  "SANAD Local Password Recovery",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "event":  [
                  {
                      "script":  {
                                     "exec":  [
                                                  "const origin = pm.variables.get(\"base_url\"); if (!/^http:\\/\\/(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]+)?$/.test(origin)) { pm.execution.skipRequest(); throw new Error(\"Only local Laravel origins are allowed\"); }"
                                              ],
                                     "type":  "text/javascript"
                                 },
                      "listen":  "prerequest"
                  }
              ],
    "item":  [
                 {
                     "request":  {
                                     "body":  {
                                                  "raw":  "{\r\n    \"email\":  \"{{email}}\",\r\n    \"language\":  \"en\"\r\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              },
                                                  "mode":  "raw"
                                              },
                                     "method":  "POST",
                                     "url":  "{{base_url}}/api/auth/password/forgot",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 },
                     "name":  "1 Forgot password",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "if (pm.response.code === 202) { const d = pm.response.json().data; pm.collectionVariables.set(\"attempt_id\", d.attempt_id); pm.collectionVariables.set(\"attempt_token\", d.attempt_token); pm.collectionVariables.unset(\"reset_proof\"); }"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "name":  "2 Queue WhatsApp OTP",
                     "request":  {
                                     "body":  {
                                                  "raw":  "{\r\n    \"attempt_token\":  \"{{attempt_token}}\",\r\n    \"attempt_id\":  \"{{attempt_id}}\"\r\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              },
                                                  "mode":  "raw"
                                              },
                                     "method":  "POST",
                                     "url":  "{{base_url}}/api/auth/password/otp/send",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 }
                 },
                 {
                     "request":  {
                                     "body":  {
                                                  "raw":  "{\r\n    \"attempt_id\":  \"{{attempt_id}}\",\r\n    \"code\":  \"{{otp_code}}\",\r\n    \"attempt_token\":  \"{{attempt_token}}\"\r\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              },
                                                  "mode":  "raw"
                                              },
                                     "method":  "POST",
                                     "url":  "{{base_url}}/api/auth/password/otp/verify",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 },
                     "name":  "3 Verify WhatsApp OTP",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "if (pm.response.code === 200) pm.collectionVariables.set(\"reset_proof\", pm.response.json().data.reset_proof);"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "name":  "4 Reset password",
                     "request":  {
                                     "body":  {
                                                  "raw":  "{\r\n    \"password_confirmation\":  \"{{new_password}}\",\r\n    \"attempt_id\":  \"{{attempt_id}}\",\r\n    \"reset_proof\":  \"{{reset_proof}}\",\r\n    \"password\":  \"{{new_password}}\",\r\n    \"attempt_token\":  \"{{attempt_token}}\"\r\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              },
                                                  "mode":  "raw"
                                              },
                                     "method":  "POST",
                                     "url":  "{{base_url}}/api/auth/password/reset",
                                     "header":  [
                                                    {
                                                        "key":  "Accept",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 }
                 }
             ]
}

{
  "info": {"name": "SANAD Phase 3 - Patient caregiver links", "description": "Maximum two pending/active caregivers per patient; caregivers can serve multiple patients.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [
    {"key":"base_url","value":"http://127.0.0.1:8000"},
    {"key":"patient_token","value":""}, {"key":"caregiver_token","value":""},
    {"key":"caregiver_username","value":""}, {"key":"link_id","value":""}, {"key":"unrelated_link_id","value":""}
  ],
  "event": [{"listen":"prerequest","script":{"type":"text/javascript","exec":[
    "const origin = pm.variables.get('base_url'); let safe = false; try { const url = new URL(origin); safe = url.protocol === 'http:' && ['127.0.0.1','localhost','[::1]'].includes(url.hostname) && url.origin === origin; } catch (_) {} if (!safe) { pm.execution.skipRequest(); throw new Error('Only local Laravel origins are allowed'); }",
    "const token = pm.variables.get(pm.info.requestName.startsWith('Caregiver:') ? 'caregiver_token' : 'patient_token'); if (!token) { pm.execution.skipRequest(); throw new Error('Supply an approved local test account token'); }"
  ]}}],
  "item": [
    {"name":"Patient: Exact caregiver lookup","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{patient_token}}"},{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/caregivers/lookup","body":{"mode":"raw","raw":"{\"username\":\"{{caregiver_username}}\"}"}}},
    {"name":"Patient: Invite caregiver (manual action)","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{patient_token}}"},{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links","body":{"mode":"raw","raw":"{\"caregiver_username\":\"{{caregiver_username}}\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Created or expected conflict', () => pm.expect(pm.response.code).to.be.oneOf([201,409])); if (pm.response.code === 201) pm.collectionVariables.set('link_id', pm.response.json().data.link.id);"]}}]},
    {"name":"Patient: Live links and slots","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{patient_token}}"},{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links"},"event":[{"listen":"test","script":{"exec":["pm.test('Two caregiver slots with consistent counts', () => { const slots = pm.response.json().data.slots; pm.expect(slots.maximum).to.eql(2); pm.expect(slots.occupied).to.be.within(0, 2); pm.expect(slots.available).to.eql(2 - slots.occupied); });"]}}]},
    {"name":"Patient: History","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{patient_token}}"},{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links?status=all&page=1&per_page=20"}},
    {"name":"Caregiver: Invitations and patients","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{caregiver_token}}"},{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links"}},
    {"name":"Caregiver: Accept invitation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{caregiver_token}}"},{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links/{{link_id}}/accept"}},
    {"name":"Caregiver: Decline invitation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{caregiver_token}}"},{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links/{{link_id}}/decline"}},
    {"name":"Patient: Cancel invitation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{patient_token}}"},{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links/{{link_id}}/cancel"}},
    {"name":"Patient: Revoke active link","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{patient_token}}"},{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links/{{link_id}}/revoke"}},
    {"name":"Caregiver: Leave active link","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{caregiver_token}}"},{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links/{{link_id}}/revoke"}},
    {"name":"Caregiver: Cannot invite (403)","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{caregiver_token}}"},{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links","body":{"mode":"raw","raw":"{\"caregiver_username\":\"{{caregiver_username}}\"}"}},"event":[{"listen":"test","script":{"exec":["pm.test('Wrong role denied', () => pm.response.to.have.status(403));"]}}]},
    {"name":"Caregiver: Unrelated invitation hidden (404)","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{caregiver_token}}"},{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links/{{unrelated_link_id}}/accept"},"event":[{"listen":"test","script":{"exec":["pm.test('Unrelated resource hidden', () => pm.response.to.have.status(404));"]}}]},
    {"name":"Patient: Reject identity manipulation (422)","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{patient_token}}"},{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/caregiver-links","body":{"mode":"raw","raw":"{\"caregiver_username\":\"{{caregiver_username}}\",\"role\":\"patient\",\"status\":\"active\"}"}},"event":[{"listen":"test","script":{"exec":["pm.test('Identity and state manipulation rejected', () => pm.response.to.have.status(422));"]}}]}
  ]
}
